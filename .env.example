# העתק את הקובץ הזה ל-.env והחלף בערכים האמיתיים
# cp .env.example .env

# Claude API key — קבל מ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Growbytes AI Gateway base URL (אופציונלי, ברירת מחדל: http://127.0.0.1:5055)
# הסוכן המקומי שמרכז את כל קריאות ה-AI ומנתב לספק (Ollama / OpenAI / Anthropic / וכו').
# בשלב הזה רק ה-client נוסף (src/services/aiGatewayClient.ts) — שום פיצ'ר קיים עוד לא משתמש בו.
AI_GATEWAY_URL=http://127.0.0.1:5055
